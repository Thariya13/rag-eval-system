# ---- Models (any init_chat_model / init_embeddings string: "provider:model") ----
OPENAI_API_KEY=sk-...
LLM_MODEL=openai:gpt-5-mini

LLM_TEMPERATURE=
CONTEXTUALIZER_MODEL=openai:gpt-5-mini

JUDGE_MODEL=openai:gpt-4.1
JUDGE_TEMPERATURE=0
EMBEDDING_MODEL=openai:text-embedding-3-small

# ---- Reranking ----
CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
# COHERE_API_KEY=...

# ---- Vector DB ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_PREFIX=euaiact

# ---- Tracing: Langfuse (preferred) ----
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---- Tracing: LangSmith (alternative) ----
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=...
# LANGSMITH_PROJECT=rag-eval-system